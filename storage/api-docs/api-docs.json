    "paths": {
        "/parcels": {
            "get": {
                "tags": [
                    "Parcels"
                ],
                "summary": "Get list of parcels",
                "operationId": "a147fca004df223388151902c8c104ed",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number",
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Items per page",
                        "schema": {
                            "type": "integer",
                            "example": 15
                        }
                    },
                    {
                        "name": "tracking_code",
                        "in": "query",
                        "description": "Filter by tracking code",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "sender_mobile",
                        "in": "query",
                        "description": "Filter by sender mobile",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "receiver_mobile",
                        "in": "query",
                        "description": "Filter by receiver mobile",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "tracking_code": {
                                                        "type": "string",
                                                        "example": "TRK170420234567"
                                                    },
                                                    "weight": {
                                                        "type": "number",
                                                        "format": "float",
                                                        "example": 2.5
                                                    },
                                                    "dimensions": {
                                                        "properties": {
                                                            "length": {
                                                                "type": "number",
                                                                "format": "float",
                                                                "example": 30
                                                            },
                                                            "width": {
                                                                "type": "number",
                                                                "format": "float",
                                                                "example": 20
                                                            },
                                                            "height": {
                                                                "type": "number",
                                                                "format": "float",
                                                                "example": 15
                                                            }
                                                        },
                                                        "type": "object"
                                                    },
                                                    "sender": {
                                                        "properties": {
                                                            "name": {
                                                                "type": "string",
                                                                "example": "علی رضایی"
                                                            },
                                                            "mobile": {
                                                                "type": "string",
                                                                "example": "09123456789"
                                                            },
                                                            "postal_code": {
                                                                "type": "string",
                                                                "example": "1234567890"
                                                            },
                                                            "address": {
                                                                "type": "string",
                                                                "example": "تهران، خیابان ولیعصر"
                                                            }
                                                        },
                                                        "type": "object"
                                                    },
                                                    "receiver": {
                                                        "properties": {
                                                            "name": {
                                                                "type": "string",
                                                                "example": "محمد حسینی"
                                                            },
                                                            "mobile": {
                                                                "type": "string",
                                                                "example": "09351234567"
                                                            },
                                                            "postal_code": {
                                                                "type": "string",
                                                                "example": "0987654321"
                                                            },
                                                            "address": {
                                                                "type": "string",
                                                                "example": "مشهد، بلوار وکیل آباد"
                                                            }
                                                        },
                                                        "type": "object"
                                                    },
                                                    "created_at": {
                                                        "type": "string",
                                                        "example": "2024-01-01 12:00:00"
                                                    },
                                                    "updated_at": {
                                                        "type": "string",
                                                        "example": "2024-01-01 12:00:00"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        },
                                        "meta": {
                                            "properties": {
                                                "current_page": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "last_page": {
                                                    "type": "integer",
                                                    "example": 5
                                                },
                                                "per_page": {
                                                    "type": "integer",
                                                    "example": 15
                                                },
                                                "total": {
                                                    "type": "integer",
                                                    "example": 75
                                                },
                                                "from": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "to": {
                                                    "type": "integer",
                                                    "example": 15
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "links": {
                                            "properties": {
                                                "first": {
                                                    "type": "string",
                                                    "example": "http://localhost:8000/api/parcels?page=1"
                                                },
                                                "last": {
                                                    "type": "string",
                                                    "example": "http://localhost:8000/api/parcels?page=5"
                                                },
                                                "prev": {
                                                    "type": "string",
                                                    "example": null
                                                },
                                                "next": {
                                                    "type": "string",
                                                    "example": "http://localhost:8000/api/parcels?page=2"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Parcels"
                ],
                "summary": "Create a new parcel",
                "operationId": "fd43541acb33cd637a05f78d7843cb7f",
                "requestBody": {
                    "description": "Parcel data with sender, receiver, weight and dimensions",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "sender",
                                    "receiver",
                                    "weight",
                                    "dimensions"
                                ],
                                "properties": {
                                    "sender": {
                                        "required": [
                                            "name",
                                            "mobile",
                                            "postal_code",
                                            "address"
                                        ],
                                        "properties": {
                                            "name": {
                                                "description": "Sender's full name (required)",
                                                "type": "string",
                                                "example": "علی رضایی"
                                            },
                                            "mobile": {
                                                "description": "Sender's mobile number (required, format: 09xxxxxxxxx)",
                                                "type": "string",
                                                "example": "09123456789"
                                            },
                                            "postal_code": {
                                                "description": "Sender's postal code (required, 10 digits)",
                                                "type": "string",
                                                "example": "1234567890"
                                            },
                                            "address": {
                                                "description": "Sender's complete address (required)",
                                                "type": "string",
                                                "example": "تهران، خیابان ولیعصر"
                                            }
                                        },
                                        "type": "object"
                                    },
                                    "receiver": {
                                        "required": [
                                            "name",
                                            "mobile",
                                            "postal_code",
                                            "address"
                                        ],
                                        "properties": {
                                            "name": {
                                                "description": "Receiver's full name (required)",
                                                "type": "string",
                                                "example": "محمد حسینی"
                                            },
                                            "mobile": {
                                                "description": "Receiver's mobile number (required, format: 09xxxxxxxxx)",
                                                "type": "string",
                                                "example": "09351234567"
                                            },
                                            "postal_code": {
                                                "description": "Receiver's postal code (required, 10 digits)",
                                                "type": "string",
                                                "example": "0987654321"
                                            },
                                            "address": {
                                                "description": "Receiver's complete address (required)",
                                                "type": "string",
                                                "example": "مشهد، بلوار وکیل آباد"
                                            }
                                        },
                                        "type": "object"
                                    },
                                    "weight": {
                                        "description": "Package weight in kilograms (required, min: 0.1, max: 100)",
                                        "type": "number",
                                        "format": "float",
                                        "example": 2.5
                                    },
                                    "dimensions": {
                                        "required": [
                                            "length",
                                            "width",
                                            "height"
                                        ],
                                        "properties": {
                                            "length": {
                                                "description": "Package length in cm (required, min: 1, max: 200)",
                                                "type": "number",
                                                "format": "float",
                                                "example": 30
                                            },
                                            "width": {
                                                "description": "Package width in cm (required, min: 1, max: 200)",
                                                "type": "number",
                                                "format": "float",
                                                "example": 20
                                            },
                                            "height": {
                                                "description": "Package height in cm (required, min: 1, max: 200)",
                                                "type": "number",
                                                "format": "float",
                                                "example": 15
                                            }
                                        },
                                        "type": "object"
                                    },
                                    "tracking_code": {
                                        "description": "Custom tracking code (optional - if not provided, system will generate one automatically)",
                                        "type": "string",
                                        "example": "TRKABC123DEF"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Parcel created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Parcel created successfully"
                                        },
                                        "data": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "tracking_code": {
                                                    "type": "string",
                                                    "example": "TRKABC123DEF"
                                                },
                                                "created_at": {
                                                    "type": "string",
                                                    "example": "2024-01-01 12:00:00"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation errors",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Validation errors"
                                        },
                                        "errors": {
                                            "properties": {
                                                "sender.mobile": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string",
                                                        "example": "فرمت شماره موبایل فرستنده صحیح نیست"
                                                    }
                                                },
                                                "weight": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string",
                                                        "example": "فیلد وزن الزامی است"
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Parcels",
            "description": "Parcels"
        }
