{
    "openapi": "3.0.0",
    "info": {
        "title": "Postal Registration API",
        "description": "Postal Registration - Laravel API Documentation",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000/api"
        }
    ],
    "paths": {
        "/postal-packages": {
            "get": {
                "tags": [
                    "Postal Packages"
                ],
                "summary": "List all postal-packages",
                "operationId": "e3339a7df6604f8d48bbd3173326e427",
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/PostalPackageResource"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "PostalPackageResource": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": "3"
                    },
                    "name": {
                        "type": "string",
                        "example": "user1"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "user1@example.com"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-03-11 20:40:54"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-03-11 20:40:54"
                    },
                    "image": {
                        "type": "string",
                        "example": "/users/images/user1.jpg"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Postal Packages",
            "description": "Postal Packages"
        }
    ]
}